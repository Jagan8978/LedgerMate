# Copy to .env.production on the server. Replace placeholders locally; never commit the real file.
PUBLIC_HOSTNAME=your-subdomain.duckdns.org

# PostgreSQL credentials: use a unique strong password; do not reuse local development values.
DB_NAME=ledgermate
DB_USERNAME=ledgermate
DB_PASSWORD=replace-with-a-long-random-password

# Base64 encoding of at least 32 cryptographically random bytes; generate on your own machine.
JWT_SECRET=replace-with-generated-base64-secret-at-least-32-bytes
JWT_TTL_MINUTES=120

# Production safety settings. Compose also enforces these values for the backend.
COOKIE_SECURE=true
DEMO_DATA_ENABLED=false
DEMO_PASSWORD=

# Optional. Leave unset to use DB_HOST/DB_PORT/DB_NAME (Compose sets DB_HOST=db).
# DB_URL=