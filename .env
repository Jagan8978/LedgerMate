# LedgerMate configuration. Copy this file to ".env" in the project root and replace every
# <placeholder>. The real ".env" file is git-ignored: never commit it.

# --- Database (PostgreSQL) -----------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/ledgermate
DB_USERNAME=ledgermate
DB_PASSWORD=Jagan@8978

# --- Authentication ------------------------------------------------------------------------
# Base64 text of at least 32 random bytes (the README shows how to generate one).
# The backend refuses to start if this is missing, malformed or too short.
JWT_SECRET=ulHdD6yO8wV2kUXm+jDBrxmuxKm21cyA2EK7rCARJVBqD9J63qtIPR6tWqHTLeCP
JWT_TTL_MINUTES=120

# --- Web / CORS ----------------------------------------------------------------------------
SERVER_PORT=8080
# Browser origin(s) allowed to call the API, comma separated. In development the Vite dev server
# proxies /api, so this normally stays as is.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set to true when the site is served over HTTPS (production). Marks the cookies "Secure".
COOKIE_SECURE=false

# --- Optional demo data --------------------------------------------------------------------
# When true, the first start creates demo@ledgermate.local with the example ledger from the
# specification (credits 5,000 + 2,000, debits 1,500 + 500 = balance 5,000.00).
DEMO_DATA_ENABLED=false
DEMO_PASSWORD=<choose-a-demo-password-of-10-or-more-characters>
